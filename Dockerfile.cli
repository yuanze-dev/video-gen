FROM node:22-bookworm-slim AS builder

WORKDIR /src
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
RUN npm run pack:cli

FROM node:22-bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 \
    libdbus-1-3 \
    libatk1.0-0 \
    libgbm-dev \
    libasound2 \
    libxrandr2 \
    libxkbcommon-dev \
    libxfixes3 \
    libxcomposite1 \
    libxdamage1 \
    libatk-bridge2.0-0 \
    libpango-1.0-0 \
    libcairo2 \
    libcups2 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /src/.artifacts/*.tgz /tmp/littlestart-cli.tgz
RUN npm install --global /tmp/littlestart-cli.tgz --ignore-scripts --no-audit --no-fund \
  && rm /tmp/littlestart-cli.tgz \
  && mkdir -p /var/cache/littlestart /work \
  && chown -R node:node /var/cache/littlestart /work

ENV LITTLESTART_CACHE_DIR=/var/cache/littlestart
ENV LITTLESTART_CHROMIUM_GL=swangle
USER node
RUN littlestart doctor --fix --json

WORKDIR /work
ENTRYPOINT ["littlestart"]
CMD ["help"]
