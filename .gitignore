# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# generated build artifacts
/public/remotion-site/
/electron/dist/
/cli/dist/
/packages/littlestart-cli/dist/
/packages/littlestart-cli/runtime/
/packages/littlestart-cli/skills/
/packages/littlestart-cli/README.md
/.artifacts/
/output/
/.remotion-build/

# electron-builder output
/release/

# production (CRA leftover — Next uses .next/). build/ holds electron-builder
# release resources (signing/notarize/icon/dmg), which MUST stay tracked.
/build/*
!/build/entitlements.mac.plist
!/build/notarize.cjs
!/build/verify-cli-resource.cjs
!/build/icon.icns
!/build/dmg-bg.png
!/build/dmg-bg@2x.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
