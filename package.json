{
  "name": "video-gen",
  "version": "0.2.2",
  "private": true,
  "description": "小音符起号助手 — 提词器视频生成器（本机渲染桌面版）",
  "author": "原则科技 Yuanze",
  "main": "electron/dist/main.cjs",
  "scripts": {
    "dev": "next dev",
    "cli": "node scripts/cli.mjs",
    "build:remotion-site": "node scripts/build-remotion-site.mjs",
    "build": "npm run build:remotion-site && next build",
    "start": "next start",
    "lint": "eslint",
    "test:update": "node --no-warnings --experimental-strip-types --test tests/desktop-update.test.mts",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build:electron && electron .",
    "electron:build": "npm run build:remotion-site && npm run build:electron && electron-builder --mac"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-three/fiber": "^9.6.1",
    "@remotion/bundler": "^4.0.481",
    "@remotion/player": "^4.0.481",
    "@remotion/renderer": "^4.0.481",
    "@remotion/three": "^4.0.481",
    "@types/three": "^0.184.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "^4.0.481",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
